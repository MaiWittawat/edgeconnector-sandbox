# คัดลอกเป็น .env แล้วแก้ตามแบบที่ใช้ (README.md) · .env ไม่ถูก commit

# ── center ที่ manager ต่อ ──────────────────────────────────
# แบบ 1 center ตัวอย่าง (go run ./center): ค่าตามนี้ได้เลย
CENTER_ADDR=host.docker.internal:7443
INSECURE=true
# แบบ 2 center ของคุณเอง: ใส่ที่อยู่ของ center · INSECURE=false · ถ้า center ใช้ CA ส่วนตัว วางไฟล์ไว้ที่ ./certs/ca.pem แล้วตั้ง CA
# CENTER_ADDR=center.example.com:7443
# INSECURE=false
# CA=/certs/ca.pem

# enrollment token ชนิด manager จากหน้า Add manager ของ center (ใช้ครั้งแรกครั้งเดียว)
TOKEN=

# ── manager ─────────────────────────────────────────────────
# ว่าง = ตาม channel ของ registry (stable) · ใส่ version เพื่อล็อก เช่น 1.1.0
MANAGER_VERSION=
MANAGER_CHANNEL=stable

# ── plugin ──────────────────────────────────────────────────
# แบบ 1 และ 2: registry จริงบน GitHub และ key ที่เซ็นไว้
REGISTRY=https://raw.githubusercontent.com/MaiWittawat/edgeconnector-registry/main
TRUSTED_KEYS=lab-2026=gK3QtGj9wHs/Vm07udIW31CySE3MVP5e/3dUj0aIXV8=
# แบบ 3: key ทิ้งของ registry ในเครื่อง (scripts/package-plugin.sh พิมพ์บรรทัดนี้ให้)
LOCAL_TRUSTED_KEYS=
